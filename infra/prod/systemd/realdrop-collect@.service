# One collection run for the brand in the instance name: realdrop-collect@defacto.service
[Unit]
Description=RealDrop collection run for %i
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/realdrop
ExecStart=/usr/bin/docker compose -f infra/prod/compose.yml run --rm app python -m realdrop.collectors.run --brand %i
# A full DeFacto pass is ~2.5 h at 1 request/s; anything far beyond that is stuck.
TimeoutStartSec=6h
