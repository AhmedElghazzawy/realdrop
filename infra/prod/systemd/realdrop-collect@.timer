# Daily collection. Phase 9 raises this to every 4 hours for the run-up to Black Friday.
[Unit]
Description=Daily RealDrop collection for %i

[Timer]
OnCalendar=*-*-* 03:00:00 Europe/Istanbul
RandomizedDelaySec=15m
# Run at boot if the server was off at the scheduled time: every missed day is lost history.
Persistent=true

[Install]
WantedBy=timers.target
