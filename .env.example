# Copy to .env and fill in. NEVER commit .env.
APP_ENV=dev

# LLM: free models only. Any OpenAI-compatible endpoint works; switch provider here, not in code.
# Default: local Ollama (run `ollama serve`, then `ollama pull gemma4:12b`). No key needed.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_FAST=gemma4:12b
LLM_MODEL_MAIN=gemma4:12b
# Free API tiers (check current free models and rate limits before using):
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1          (use models ending in :free)
#   Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/realdrop
REDIS_URL=redis://localhost:6379/0

# Honest identification for collectors; put a real contact address here in your own .env
COLLECTOR_USER_AGENT=realdrop-bot/0.1 (+https://github.com/AhmedElghazzawy/realdrop)

# Later phases
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
SENTRY_DSN=
