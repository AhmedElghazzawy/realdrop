# Copy to .env and fill in. NEVER commit .env.
APP_ENV=dev

# Anthropic (create a key in the Console and set a monthly spend limit)
ANTHROPIC_API_KEY=
# Check current model names in the Anthropic docs before changing these
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_MAIN=claude-sonnet-5-5

DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/realdrop
REDIS_URL=redis://localhost:6379/0

# Honest identification for collectors; put a real contact address here in your own .env
COLLECTOR_USER_AGENT=realdrop-bot/0.1 (contact: you@example.com)

# Later phases
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
SENTRY_DSN=
